# ==============================================================================
# 404nfd Radio Environment Configuration
# ==============================================================================

# Server HTTP Port (default: 8004)
PORT=8004

# SQLite Database Location (defaults to ../../radio.db relative to src)
DB_PATH=radio.db

# ------------------------------------------------------------------------------
# Telegram Bot & Channel Notifications
# ------------------------------------------------------------------------------
# Telegram Bot Token from @BotFather
# Used for track submissions, listener DM notifications, and channel broadcasts
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram Public Channel username or ID for live now-playing broadcasts
# Example: @NFD404radio or -1001234567890
TELEGRAM_CHANNEL_ID=@your_radio_channel

# Telegram user IDs permitted to run admin commands (e.g. /skip, /queue)
# Comma-separated list of numeric Telegram IDs
ADMIN_TELEGRAM_IDS=123456789,987654321

# ------------------------------------------------------------------------------
# YouTube Data API Integration (Optional)
# ------------------------------------------------------------------------------
# Google Cloud Console -> Credentials -> YouTube Data API v3 key
# Enables /api/search to search and queue tracks from YouTube
YOUTUBE_API_KEY=
